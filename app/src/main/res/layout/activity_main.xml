<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Строка поиска -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="12dp"
        android:background="@drawable/panel_bg"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="6dp">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E8E93"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_search"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <!-- Кнопки масштаба и вида карты -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/zoomInButton"
            style="@style/MapButton"
            android:contentDescription="@string/action_zoom_in"
            android:src="@drawable/ic_plus" />

        <ImageButton
            android:id="@+id/zoomOutButton"
            style="@style/MapButton"
            android:contentDescription="@string/action_zoom_out"
            android:src="@drawable/ic_minus" />

        <ImageButton
            android:id="@+id/worldButton"
            style="@style/MapButton"
            android:contentDescription="@string/action_world"
            android:src="@drawable/ic_globe" />

        <ImageButton
            android:id="@+id/styleButton"
            style="@style/MapButton"
            android:contentDescription="@string/action_style"
            android:src="@drawable/ic_layers" />
    </LinearLayout>

    <!-- Карточка выбранного места. Отступ снизу оставляет видимой подпись об источнике карты. -->
    <LinearLayout
        android:id="@+id/infoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="44dp"
        android:background="@drawable/card_bg"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/infoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/closeCardButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/infoAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:paddingEnd="8dp"
            android:textColor="#C7C7CC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/infoCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textColor="#0A84FF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
